{
  "name": "game-player-lens",
  "version": "0.1.0",
  "description": "Evidence-grounded Steam player research and simulation MCP server",
  "private": false,
  "type": "module",
  "bin": {
    "game-player-lens": "dist/cli.js"
  },
  "files": [
    "dist",
    "knowledge/rubrics",
    "knowledge/templates",
    "docs/guides",
    "docs/reference",
    "skills",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZaK3939/GamePlayerLens.git"
  },
  "homepage": "https://github.com/ZaK3939/GamePlayerLens#readme",
  "bugs": {
    "url": "https://github.com/ZaK3939/GamePlayerLens/issues"
  },
  "keywords": [
    "mcp",
    "steam",
    "game-development",
    "user-research",
    "personas"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc",
    "test": "vitest run --config vitest.config.ts",
    "test:live": "RUN_LIVE=1 vitest run --config vitest.live.config.ts",
    "test:all": "pnpm test && pnpm test:live",
    "smoke:stdio": "tsx scripts/smoke-stdio.ts",
    "check:package": "node scripts/check-package-contents.mjs",
    "smoke:package": "pnpm build && pnpm check:package && tsx scripts/smoke-package.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "atomically": "2.1.1",
    "puppeteer-core": "^25.5.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
